# ==============================================================================
# Environment Configuration Template for Mandate Control Plane
# ==============================================================================
# Use placeholders only. Do NOT commit production secrets.
#
# Categories:
#   [REQUIRED]   - Must be present for the application to function
#   [OPTIONAL]   - Sensible defaults apply if omitted
#   [DEMO-ONLY]  - Recommended for publicly accessible showcase/demonstrator
#   [PROD-ONLY]  - Enforced strictly when ENVIRONMENT=production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
# ENVIRONMENT options: 'development' (local dev), 'demo' (public demo showcase), 'production' (live financial)
# [REQUIRED]
ENVIRONMENT=demo
# [OPTIONAL] Set to false for demo and production deployments
DEBUG=false
LOG_LEVEL=INFO

# Dynamic Port Binding:
# Render automatically injects PORT. If PORT is unset, API_PORT will be used.
PORT=8000
API_PORT=8000
API_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Render automatically provides DATABASE_URL on managed PostgreSQL instances.
# Supported formats: postgres://, postgresql://, or postgresql+asyncpg://
# (The application automatically normalizes cloud connection strings and sslmode for asyncpg)
# [REQUIRED]
DATABASE_URL=postgresql+asyncpg://mandate_user:mandate_secure_password@localhost:5432/mandate_db

# Local Docker Compose helpers (optional):
POSTGRES_USER=mandate_user
POSTGRES_PASSWORD=mandate_secure_password
POSTGRES_DB=mandate_db
POSTGRES_EXTERNAL_PORT=5433

# ------------------------------------------------------------------------------
# 3. Cache & Concurrency Limiter (Redis / Key Value)
# ------------------------------------------------------------------------------
# Render Key Value provides REDIS_URL (rediss://... with TLS).
# Local development uses standard redis://.
# [REQUIRED for distributed rate limiting; graceful fallback provided]
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Schema Synchronization & Demo Bootstrapping
# ------------------------------------------------------------------------------
# [DEMO-ONLY] When true in 'demo' or 'development' mode, automatically synchronizes tables on startup:
AUTO_MIGRATE_ON_STARTUP=true

# [DEMO-ONLY] When true in 'demo' or 'development' mode, automatically seeds the 3 agents and 3 mandates:
AUTO_SEED_DEMO=true

# ------------------------------------------------------------------------------
# 5. Razorpay Configuration (Mock / Test Mode)
# ------------------------------------------------------------------------------
# [DEMO-ONLY] Set RAZORPAY_MOCK_MODE=true for the public reviewer demonstration.
# No real financial transactions or live Razorpay account secrets required!
RAZORPAY_MOCK_MODE=true

# Test credentials (placeholders sufficient in mock mode; live test keys optional):
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=sample_secret_key_for_testing_purposes_only
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_key_for_testing
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ------------------------------------------------------------------------------
# 6. LLM Providers Configuration
# ------------------------------------------------------------------------------
# [OPTIONAL for demo] The interactive demo uses deterministic mock execution paths.
# If testing the conversational agent with live OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_LLM_PROVIDER=openai

# ------------------------------------------------------------------------------
# 7. Security & CORS
# ------------------------------------------------------------------------------
# [REQUIRED] Secret key for HMAC token hashing (minimum 32 characters):
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_long

# [REQUIRED for Frontend Integration]
# Comma-separated list of allowed origins. Add your Vercel public domain here:
# Example: https://mandate-razorpay-control-plane.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://mandate-razorpay-control-plane.vercel.app

# ------------------------------------------------------------------------------
# 8. Background Worker Settings
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 9. Frontend Environment (apps/web)
# ------------------------------------------------------------------------------
# In Vercel Project Settings -> Environment Variables:
# [REQUIRED in apps/web] URL of your deployed FastAPI backend on Render:
# Example: NEXT_PUBLIC_API_URL=https://mandate-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
