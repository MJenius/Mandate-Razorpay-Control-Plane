# Environment configuration for Mandate

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
API_PORT=8000
API_HOST=0.0.0.0

# Database (PostgreSQL)
POSTGRES_USER=mandate_user
POSTGRES_PASSWORD=mandate_secure_password
POSTGRES_DB=mandate_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mandate_user:mandate_secure_password@localhost:5432/mandate_db
DATABASE_URL_DOCKER=postgresql+asyncpg://mandate_user:mandate_secure_password@postgres:5432/mandate_db

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_URL_DOCKER=redis://redis:6379/0

# Razorpay Test Mode Credentials (Get from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Security & CORS
SECRET_KEY=dev-mandate-secret-key-change-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Worker Settings
WORKER_CONCURRENCY=4
