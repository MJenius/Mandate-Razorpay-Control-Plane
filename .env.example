# Environment configuration template for Mandate

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
API_PORT=8000
API_HOST=0.0.0.0

# Database (PostgreSQL)
POSTGRES_USER=mandate_user
POSTGRES_PASSWORD=mandate_secure_password
POSTGRES_DB=mandate_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mandate_user:mandate_secure_password@localhost:5432/mandate_db
DATABASE_URL_DOCKER=postgresql+asyncpg://mandate_user:mandate_secure_password@postgres:5432/mandate_db

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_URL_DOCKER=redis://redis:6379/0

# Razorpay Configuration (Get Test Mode credentials from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_MOCK_MODE=true

# Security & CORS
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Worker Settings
WORKER_CONCURRENCY=4
